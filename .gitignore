# Secrets
.env
.env.*
!.env.example

# Telethon login session — grants full access to the Telegram account. Never commit.
*.session
*.session-journal

# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# Node / web build artefacts
web/node_modules/
web/dist/
web/.astro/
web/.wrangler/

# Raw Telegram exports — contain PII from real applicants. Do not commit.
# Aggregated, anonymised public data lives at web/public/analytics.json.
data/citizenship/ChatExport_*/

# Local-only PDF cache (the source PDF is public; CLAUDE.md notes where to download it).
data/citizenship_test/discover-canada.pdf
data/citizenship_test/pages_text.json

# Original Colab reference notebook has an inlined OpenAI key (and Google
# Drive paths that don't apply locally). Keep it on disk for reference but
# never commit it.
notebooks/googlecolab.ipynb

# Local-only project memory file (lives on disk; not committed).
CLAUDE.md

# Curated work product + aggregated public data are now tracked (decided
# 2026-06-16) so there's a recoverable snapshot — the served copies are already
# public via the live site anyway. Raw Telegram exports (PII) stay ignored above.

# Windows download-metadata streams that WSL surfaces as files
*:Zone.Identifier

# Tooling cruft
*.log
.cache/
.claude/
